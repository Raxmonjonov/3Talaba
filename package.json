{
  "name": "3talab",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "npm run dev --workspace=@3talab/api",
    "dev:web": "npm run dev --workspace=@3talab/web",
    "build": "npm run build --workspace=@3talab/api && npm run build --workspace=@3talab/web",
    "typecheck": "npm run typecheck --workspace=@3talab/api && npm run typecheck --workspace=@3talab/web",
    "lint": "npm run lint --workspace=@3talab/web",
    "db:reset": "npm run db:reset --workspace=@3talab/api",
    "seed": "npm run seed --workspace=@3talab/api",
    "test": "npm run test --workspace=@3talab/api",
    "test:e2e": "npm run test:e2e --workspace=@3talab/web"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "allowScripts": {
    "prisma@5.22.0": true,
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "esbuild@0.28.2": true
  }
}
