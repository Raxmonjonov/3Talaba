# ==============================================================================
# 3Talab — Environment Variables (.env.example)
# ==============================================================================

# 1. Ma'lumotlar bazasi (Lokal uchun SQLite, Ishlab chiqarish uchun PostgreSQL)
DATABASE_URL="file:./dev.db"
# PostgreSQL namunasi:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/3talab?schema=public"

# 2. NextAuth (Autentifikatsiya)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-secure-random-32-byte-secret"

# Google OAuth (ixtiyoriy — Google orqali kirish uchun)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# 3. AI Murabbiy (/lib/ai provayder-agnostik qatlam)
# Qiymatlar: "local" | "gemini" | "anthropic" | "openrouter"
AI_PROVIDER="local"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-5-sonnet-latest"
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="google/gemini-2.5-flash"
