# ==============================================================================
# 3Talaba Campus — Environment Variables (.env.example)
# ==============================================================================

# 1. Ma'lumotlar bazasi (Lokal uchun SQLite, Production uchun PostgreSQL)
DATABASE_URL="file:./dev.db"
# PostgreSQL namunasi (Docker/VPS yoki Netlify Postgres):
# DATABASE_URL="postgresql://talaba:strong_password@db:5432/3talaba_prod?schema=public&sslmode=prefer"

# 2. NextAuth va Ma'lumotlarni Shifrlash Kalitlari (AES-256-GCM + JWE A256GCM)
# Yaratish uchun: openssl rand -base64 32
NEXTAUTH_URL="https://3talaba.uz"
NEXTAUTH_SECRET="replace-with-a-secure-random-32-byte-secret"
DATA_ENCRYPTION_KEY="replace-with-a-separate-32-byte-aes-256-gcm-master-key"

# Google OAuth (ixtiyoriy — Google orqali kirish uchun)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# 3. Talaba AI Murabbiy (/lib/ai provayder-agnostik qatlam)
# Qiymatlar: "local" | "gemini" | "anthropic" | "openrouter"
AI_PROVIDER="local"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-5-sonnet-latest"
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="google/gemini-2.5-flash"

# 4. Talaba AI Jonli Ovozli Ustoz (Gemini Live API)
GEMINI_LIVE_MODEL="gemini-2.5-flash-native-audio-preview-12-2025"
GEMINI_LIVE_VOICE="Puck"
