{
    "name": "@3talab/api",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "main": "dist/index.js",
  "scripts": {
    "dev": "npm run prisma:generate && tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src tests",
    "prisma:generate": "prisma generate --schema=prisma/schema.prisma",
    "prisma:generate:pg": "prisma generate --schema=prisma/schema.postgresql.prisma",
    "prisma:push": "prisma db push",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "seed": "tsx prisma/seed/seed.ts",
    "db:reset": "prisma db push --force-reset && npm run seed",
    "test": "vitest run"
  },
    "dependencies": {
        "@netlify/functions": "^6.0.2",
        "@prisma/adapter-pg": "^5.22.0",
        "@prisma/client": "^5.22.0",
        "bcryptjs": "^2.4.3",
        "cors": "^2.8.5",
        "dotenv": "^16.4.7",
        "express": "^4.21.2",
        "express-rate-limit": "^8.7.1",
        "helmet": "^8.3.0",
        "jsonwebtoken": "^9.0.2",
        "pg": "^8.23.1",
        "serverless-http": "^4.0.0",
        "zod": "^3.24.1"
    },
    "devDependencies": {
        "@types/bcryptjs": "^2.4.6",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/jsonwebtoken": "^9.0.7",
        "@types/node": "^22.10.2",
        "@types/pg": "^8.23.1",
        "oxlint": "^1.87.0",
        "prisma": "^5.22.0",
        "tsx": "^4.19.2",
        "typescript": "^5.7.2",
        "vitest": "^5.0.3"
    }
}
