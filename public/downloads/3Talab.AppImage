#!/bin/bash
# 3Talab Desktop Launcher for Kali Linux, Ubuntu, and Debian
# Ensures 3Talab opens in application mode

APP_URL="https://3talaba.netlify.app"

echo "=== 3Talab Desktop Launcher (Kali Linux / Ubuntu / Debian) ==="

# Check available browser to launch as standalone window
if command -v google-chrome &> /dev/null; then
    google-chrome --app="$APP_URL"
elif command -v chromium &> /dev/null; then
    chromium --app="$APP_URL"
elif command -v chromium-browser &> /dev/null; then
    chromium-browser --app="$APP_URL"
elif command -v brave-browser &> /dev/null; then
    brave-browser --app="$APP_URL"
elif command -v firefox &> /dev/null; then
    firefox --new-window "$APP_URL"
else
    xdg-open "$APP_URL"
fi
